// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// โครงสร้างอ้างอิงจาก surinhos_asset database (MySQL)
// Dev ใช้ SQLite + Prisma ORM แต่ column name ตรงกับ surinhos เดิมทุก field

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// ตารางสถานที่ (อ้างอิงจาก surinhos locations)
// ==========================================
model Location {
  id            String   @id @default(cuid())
  buildingName  String                      // ชื่ออาคาร เช่น อาคารอำนวยการ
  roomName      String                      // ชื่อห้อง เช่น ห้องไอที ชั้น 2
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assets Asset[]
}

// ==========================================
// ตารางครุภัณฑ์ (อ้างอิงจาก surinhos assets)
// ==========================================
model Asset {
  id            String    @id @default(cuid())
  assetCode     String    @unique               // หมายเลขครุภัณฑ์ เช่น COM-69-001 (surinhos: asset_code)
  name          String                           // ชื่ออุปกรณ์ (surinhos: name)
  category      String                           // หมวดหมู่ (surinhos: category)
  locationId    String?                          // FK -> Location.id (surinhos: location_id)
  status        String    @default("ปกติ")      // surinhos: status ENUM
  acquiredDate  String?                          // วันที่ได้มา
  price         Float?                           // ราคา (surinhos: price DECIMAL)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  location    Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  repairTickets RepairTicket[]
}

// ==========================================
// ตารางแจ้งซ่อม (อ้างอิงจาก surinhos repair_tickets)
// สถานะ 6 ขั้น: pending → accepted → in_progress → returned → closed | cancelled
// ==========================================
model RepairTicket {
  id             String    @id @default(cuid())

  // --- ข้อมูลพื้นฐาน (surinhos เดิมมีแล้ว) ---
  ticketNo       String    @unique               // เลขที่ใบแจ้งซ่อม RPR-YYMMDD-NNN (surinhos: ticket_no)
  assetId        String?                          // FK -> Asset.id (surinhos: asset_id)
  assetName      String                           // ชื่ออุปกรณ์/สถานที่ (surinhos: asset_name)
  problemDetails String?                          // รายละเอียดปัญหา (surinhos: problem_details)
  reporterName   String?                          // ชื่อผู้แจ้ง (surinhos: reporter_name)

  // --- สถานะ (เพิ่ม cancelled จากเดิม 5 → 6) ---
  // pending, accepted, in_progress, returned, closed, cancelled
  status         String    @default("pending")   // surinhos: status ENUM

  // --- ข้อมูลรับเรื่อง (surinhos เดิมมี) ---
  receivedBy     String?                          // ช่างที่รับเรื่อง (surinhos: received_by)
  receivedAt     DateTime?                         // เวลารับเรื่อง (surinhos: received_at)

  // --- ลายเซ็นตอนรับ (surinhos เดิมมี) ---
  senderSignature    String?                       // ลายเซ็นผู้ส่ง (Base64 PNG) (surinhos: sender_signature)
  receiverSignature  String?                       // ลายเซ็นผู้รับ (Base64 PNG) (surinhos: receiver_signature)

  // --- ข้อมูลส่งคืน (surinhos เดิมมี) ---
  returnMethod          String?                    // หน่วยงานมารับเอง / ช่างไปส่งคืน (surinhos: return_method)
  returnedBy            String?                    // ผู้ที่ส่งคืน/รับคืน (surinhos: returned_by)
  returnedAt            DateTime?                   // เวลาส่งคืน (surinhos: returned_at)
  returnSenderSignature    String?                // ลายเซ็นผู้ส่งคืน (Base64 PNG) (surinhos: return_sender_signature)
  returnReceiverSignature  String?                 // ลายเซ็นผู้รับคืน (Base64 PNG) (surinhos: return_receiver_signature)

  // --- เสนอราคาซ่อม (ใหม่ — surinhos ไม่มี) ---
  repairCost     Float?                           // ค่าอะไหล่ (THB)
  laborCost      Float?                           // ค่าแรงงาน (THB)
  totalCost      Float?                           // รวมทั้งหมด (computed: repairCost + laborCost)
  costStatus     String?                          // pending / approved / rejected — สถานะอนุมัติค่าใช้จ่าย

  // --- ยกเลิก/ไม่คุ้มซ่อม (ใหม่ — surinhos ไม่มี) ---
  cancelReason   String?                          // เหตุผลการยกเลิก (เช่น อะไหล่หายาก, ค่าซ่อมสูงกว่าราคาเครื่อง)

  // --- รูปประกอบการแจ้งซ่อม (ใหม่ — surinhos ไม่มี) ---
  // เก็บเป็น JSON array ของ base64 data URL หรือ file path
  // เช่น ["data:image/jpeg;base64,...", "data:image/jpeg;base64,..."]
  photos          String?                          // JSON string array

  // --- ตีแทงจำหน่าย (ใหม่ — surinhos ไม่มี) ---
  // เมื่อครุภัณฑ์ซ่อมไม่ได้ งานภาครัฐต้องผ่านขั้นตอนตีแทงจำหน่าย
  disposalStatus      String?                     // pending_review / approved / disposed
  disposalReason      String?                     // เหตุผลที่ต้องจำหน่าย (เช่น อะไหล่หมดสต็อก, ไม่สามารถซ่อมได้)
  disposalMethod      String?                     // วิธีจำหน่าย: จำหน่าย/ชำระ (ประมูล), ทำลาย, บริจาค
  disposalValue       Float?                      // ราคาประเมิน/ราคาชำระ (THB)
  disposalApprovedBy  String?                     // ผู้อนุมัติจำหน่าย
  disposalApprovedAt  DateTime?                    // วันอนุมัติ
  disposalComRef      String?                     // เลขที่หนังสือคณะกรรมการ (เช่น ครม.ที่ .../...)

  // --- timestamps ---
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // --- relations ---
  asset Asset? @relation(fields: [assetId], references: [id])
}
